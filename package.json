{
	"name": "aetherax",
	"private": true,
	"author": "Axol-l",
	"license": "UNLICENSED",
	"version": "0.2.0",
	"description": "Aetherax — WiFi coverage planner, packaged as a desktop application",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"prebuild": "node scripts/build-manual.mjs",
		"manual": "node scripts/build-manual.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:packages": "pnpm -r test",
		"test:e2e": "playwright test tests/e2e",
		"test:visual": "playwright test tests/visual",
		"test:measure": "playwright test tests/measure",
		"lint": "eslint src/ tests/",
		"verify:desktop": "node scripts/verify-desktop.mjs",
		"fonts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bundle-fonts.ps1",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"devDependencies": {
		"@aetherax/eslint-config": "workspace:*",
		"@aetherax/tsconfig": "workspace:*",
		"@playwright/test": "1.59.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.21.1",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tauri-apps/cli": "^2",
		"@typescript-eslint/eslint-plugin": "^8.32.1",
		"@typescript-eslint/parser": "^8.32.1",
		"eslint": "^9.27.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.1",
		"svelte": "^5.33.0",
		"svelte-check": "^4.2.1",
		"svelte-eslint-parser": "^1.6.0",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.1"
	},
	"dependencies": {
		"@aetherax/channels": "workspace:*",
		"@aetherax/geometry": "workspace:*",
		"@aetherax/solver": "workspace:*",
		"@tauri-apps/api": "^2",
		"@tauri-apps/plugin-opener": "^2",
		"jspdf": "^4.2.1"
	}
}
